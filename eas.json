{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "VOCOURSE_MODE": "demo"
      }
    },
    "demo": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "demo",
        "VOCOURSE_MODE": "demo",
        "VOCOURSE_SIMULATED_SPEECH": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "preview",
        "VOCOURSE_MODE": "live",
        "VOCOURSE_API_URL": "https://api-staging.vocourse.ca"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "VOCOURSE_MODE": "live",
        "VOCOURSE_API_URL": "https://api.vocourse.ca"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "À_REMPLACER_identifiant_App_Store_Connect"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
