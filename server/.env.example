# Serveur Vocourse — variables d'environnement (copier en .env, ou dans les secrets de l'hébergeur)

NODE_ENV=production
PORT=8080
# Nombre de mandataires de confiance (répartiteur de charge / proxy TLS) devant le serveur.
# L'adresse IP du client est lue dans X-Forwarded-For à cette profondeur (0 = connexion directe).
TRUST_PROXY=1
# Plafond global de textos par jour (protection contre la fraude aux textos).
SMS_DAILY_BUDGET=2000
# Fichier SQLite sur un volume persistant et sauvegardé (hébergé au Canada).
DATABASE_PATH=/data/vocourse.sqlite
# Durée de conservation des listes transmises et des comptes inactifs, en jours (Loi 25).
RETENTION_DAYS=365

# Clés secrètes : générer avec « npm run keys ». Conserver une copie hors ligne de la clé de données.
DATA_ENCRYPTION_KEY=
TOKEN_SIGNING_KEY=

# Instacart Developer Platform (tableau de bord : dashboard.instacart.com → API Keys)
INSTACART_API_KEY=
# production → https://connect.instacart.com ; development → https://connect.dev.instacart.tools
INSTACART_ENV=production
# Facultatif : lien « retour » affiché sur la page Instacart (page d'aide de Vocourse, par exemple).
INSTACART_LINKBACK_URL=

# Textos (Twilio). TWILIO_FROM : numéro canadien E.164 (+1…) ou service de messagerie (MG…).
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Compte de démonstration pour l'examen Apple / Google (laisser vide en temps normal).
# Ce numéro reçoit toujours ce code et aucun texto n'est réellement envoyé.
REVIEW_DEMO_MOBILE=
REVIEW_DEMO_CODE=
