{
  "name": "vocourse",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "npx expo-doctor",
    "fonts": "bash scripts/fetch-fonts.sh",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit:production": "eas submit --profile production --platform all"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-speech": "~57.0.0",
    "expo-speech-recognition": "^3.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.16",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
